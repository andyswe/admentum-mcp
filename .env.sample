# Copy to .env and fill in. Never commit .env.
#
# Admentum supports API access tokens, but the feature is normally not enabled
# for users out of the box. We therefore log in with username and password instead.
ADMENTUM_USERNAME=
ADMENTUM_PASSWORD=

# Only for `admentum-mcp sync-and-notify`: the shared secret that signs webhook calls
# (a whsec_<base64> secret or any random string; the receiver needs the same value).
ADMENTUM_WEBHOOK_SECRET=
